@model CrudMvcApp.Models.Student

<h2>Add Student</h2>

<form asp-action="Create" method="post">
    <div>
        Name:
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        Department:
        <input asp-for="Department" />
        <span asp-validation-for="Department"></span>
    </div>

    <div>
        Marks:
        <input asp-for="Marks" />
        <span asp-validation-for="Marks"></span>
    </div>

    <button type="submit">Save</button>
</form>
