@model List<CrudMvcApp.Models.Student>

<h2>Student List</h2>

<a asp-action="Create">Add New Student</a>

<table border="1" cellpadding="8">
    <tr>
        <th>Name</th>
        <th>Department</th>
        <th>Marks</th>
        <th>Actions</th>
    </tr>

@foreach (var s in Model)
{
    <tr>
        <td>@s.Name</td>
        <td>@s.Department</td>
        <td>@s.Marks</td>
        <td>
            <a asp-action="Edit" asp-route-id="@s.Id">Edit</a> |
            <a asp-action="Delete" asp-route-id="@s.Id">Delete</a>
        </td>
    </tr>
}
</table>
