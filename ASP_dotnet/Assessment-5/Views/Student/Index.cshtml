@model List<MvcDemoApp.Models.Student>
@Html.Partial("_StudentInfo")

<h2>Student List</h2>

<table border="1" cellpadding="8">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Marks</th>
        
    </tr>

@foreach (var s in Model)
{
    <tr>
        <td>@s.StudentId</td>
        <td>@s.Name</td>
        <td>@s.Department</td>
        <td>@s.Marks</td>
    </tr>
}
</table>
