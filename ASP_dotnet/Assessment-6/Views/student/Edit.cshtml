@model CrudMvcApp.Models.Student

<h2>Edit Student</h2>

<form asp-action="Edit" method="post">
    
    <!-- Hidden field to keep ID -->
    <input type="hidden" asp-for="Id" />

    <div>
        Name:
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        Department:
        <input asp-for="Department" />
        <span asp-validation-for="Department"></span>
    </div>

    <div>
        Marks:
        <input asp-for="Marks" />
        <span asp-validation-for="Marks"></span>
    </div>

    <button type="submit">Update</button>
    <a asp-action="Index">Cancel</a>
</form>
